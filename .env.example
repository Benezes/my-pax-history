GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
HOST=127.0.0.1
PORT=8000
# Optional: slow down the mock provider so loading UI can be tested (0 = off).
MOCK_LLM_DELAY_SECONDS=0
# Per-model Gemini attempt; slow models are abandoned for the next fallback.
GEMINI_ATTEMPT_TIMEOUT_SECONDS=50
# Wall-clock budget for the whole Gemini fallback chain (keep below the 3.5 min UI timeout).
GEMINI_TOTAL_BUDGET_SECONDS=165
